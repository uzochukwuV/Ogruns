# ── Node identity ──────────────────────────────────────────────────────────────
# Generate with: npm run keygen
# This is the ECDSA private key used to sign every signal envelope AND to send
# the publishSignal() transaction on-chain. Guard it like a production secret.
NODE_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── 0G Network ─────────────────────────────────────────────────────────────────
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# ── Platform contracts (copy from deployment output) ───────────────────────────
REGISTRY_CONTRACT_ADDR=0x...

# ── Signal configuration ───────────────────────────────────────────────────────
# The token pair this node specialises in. Must match the CEX format: BASE/USDT
TOKEN_PAIR=BTC/USDT
EXCHANGE=binance

# How many hours until an unactivated signal expires (CANCELLED)
SIGNAL_EXPIRY_HOURS=4

# Polling interval for price data (seconds)
POLL_INTERVAL_SEC=60

# ── Optional: 0G Inference ─────────────────────────────────────────────────────
# Set to use a remote ML model served via the 0G Compute/Inference network.
# Leave blank to use the built-in RSI analyzer.
ZG_INFERENCE_ENDPOINT=
ZG_INFERENCE_MODEL=signal-v1
