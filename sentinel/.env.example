# Sentinel Trading Agent Configuration

# ─── Wallet ───────────────────────────────────────────────────────────────────
# Your agent's private key (NEVER commit this!)
PRIVATE_KEY=0x...

# ─── Signal Platform ──────────────────────────────────────────────────────────
# Your verification layer API endpoint
SIGNAL_API_URL=http://localhost:8080
# Public stream endpoint (no auth required) - for AI agents
SIGNAL_WS_URL=ws://localhost:8080/api/v1/stream/public

# ─── GMX Configuration ────────────────────────────────────────────────────────
# Arbitrum RPC
# Mainnet: https://arb1.arbitrum.io/rpc
# Testnet: https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Chain ID: 42161 = Arbitrum One (mainnet), 421614 = Arbitrum Sepolia (testnet)
CHAIN_ID=421614

# GMX Testnet UI: https://app.gmxtest.io
# Get testnet ETH: https://www.alchemy.com/faucets/arbitrum-sepolia

# ─── Trading Parameters ───────────────────────────────────────────────────────
# Minimum node trust score to follow (0-100)
MIN_TRUST_SCORE=50
# Minimum node tier to follow (BRONZE, SILVER, GOLD, DIAMOND)
MIN_TIER=SILVER
# Maximum position size in USD
MAX_POSITION_USD=100
# Default collateral token
COLLATERAL_TOKEN=USDC

# ─── Risk Management ──────────────────────────────────────────────────────────
# Maximum open positions at once
MAX_OPEN_POSITIONS=3
# Auto stop-loss percentage (from entry)
AUTO_STOP_LOSS_PCT=5
# Auto take-profit percentage (from entry)
AUTO_TAKE_PROFIT_PCT=10

# ─── 0G Integration (Optional) ────────────────────────────────────────────────
# 0G Compute endpoint for AI inference
ZG_COMPUTE_URL=
# 0G Storage for trade proofs
ZG_STORAGE_URL=
