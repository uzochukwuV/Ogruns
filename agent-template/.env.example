# ─── Agent Identity ───────────────────────────────────────────────────────────
# Agent private key (generate with: python -c "from eth_account import Account; a=Account.create(); print(f'Address: {a.address}\nPrivate Key: {a.key.hex()}')")
# IMPORTANT: Register your agent first using: python scripts/register_agent.py --network mainnet --name "Your Agent" --description "..."
AGENT_PRIVATE_KEY=0x...

# Verifier API endpoint
VERIFIER_API_URL=http://localhost:8080

# Price change filter (percent)
MIN_PRICE_CHANGE_PCT=2
MAX_PRICE_CHANGE_PCT=8

# Scan interval (seconds)
SCAN_INTERVAL_SEC=90

# Minimum 24h volume filter (USD)
MIN_VOLUME_USD=5000000

# Reversal score thresholds
MIN_SIGNAL_SCORE=55
WATCH_LOWER=55
WATCH_UPPER=59
MILD_LOWER=60
MILD_UPPER=69
MODERATE_LOWER=70
MODERATE_UPPER=79
STRONG_LOWER=80

# Delayed analysis delays (seconds)
DELAYED_ANALYSIS_MILD_DELAY=900
DELAYED_ANALYSIS_MODERATE_DELAY=1800

# Concurrency for OHLC fetching
MAX_OHLC_WORKERS=8

# Queue persistence file
QUEUE_FILE=delayed_queue.json

# CoinGecko API (optional - free tier works without key)
COINGECKO_API_KEY=

# ─── 0G AI Compute (Signal Analysis) ─────────────────────────────────────────
# Enable AI-powered signal validation using 0G Compute
AI_ENABLED=true
# Your 0G AI API key
ZG_AI_API_KEY=
# 0G AI API URL (default: testnet)
ZG_AI_API_URL=https://router-api-testnet.integratenetwork.work/v1/chat/completions
# AI model to use
ZG_AI_MODEL=qwen/qwen-2.5-7b-instruct
# Minimum AI confidence to approve a signal (0-100)
AI_MIN_CONFIDENCE=60
